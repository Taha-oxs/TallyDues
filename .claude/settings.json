{
  "permissions": {
    "deny": [
      "Read(//c/ProgramData/TallyDue/pending/**)",
      "Read(//c/ProgramData/TallyDue/snooze.json)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/*.log)",
      "Read(./**/*.dmp)",
      "Read(./**/*.exe)",
      "Read(./Output/**)",
      "Read(./pending/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_tdl.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
